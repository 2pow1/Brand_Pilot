# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium

# Discord review flow
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_BASE_URL=https://discord.com/api/v10
DISCORD_PUBLIC_KEY=

# Notion record mirror
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
NOTION_BASE_URL=https://api.notion.com/v1
NOTION_VERSION=2026-03-11

# Meta / Instagram publishing
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_TOKEN_EXPIRY_WARNING_DAYS=7
META_GRAPH_BASE_URL=https://graph.facebook.com/v25.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# GitHub Actions publishing gate
INSTAGRAM_PUBLISH_ENABLED=false
INSTAGRAM_TEMPLATE=instagram-card-news-v1
INSTAGRAM_COVER_IMAGE_ENABLED=false

# Brand identity and optional CTA
BRAND_COMPANY_NAME=GrowthLine
BRAND_VOICE=clear, practical, founder-friendly
BRAND_SERVICE_SUMMARY=Branding and marketing support for small businesses.
BRAND_CTA_ENABLED=false
BRAND_CTA_LABEL=
BRAND_CTA_URL=

# App runtime
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/brand-pilot.sqlite

# Supabase production database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_STORAGE_BUCKET=brand-pilot-instagram
